# Copy to .env and fill in your values.
# ADK auto-loads pubmed_agent/.env when you run `adk web` / `adk run`.

# Use Vertex AI (Gemini via your GCP project) rather than the public Gemini API.
GOOGLE_GENAI_USE_VERTEXAI=1

# Your GCP project ID. Required for Vertex AI (Gemini) and for the
# deep_research_agent (BigQuery PMC tools). If unset, the BigQuery
# sub-agent is silently skipped.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Vertex AI location. "global" works for Gemini; pick a region (e.g.
# us-central1) if your org policy requires it.
GOOGLE_CLOUD_LOCATION=global

# Optional: NCBI E-utilities API key. Raises rate limit 3 -> 10 req/sec.
# Get one at https://www.ncbi.nlm.nih.gov/account/settings/
# PUBMED_API_KEY=your_ncbi_api_key
